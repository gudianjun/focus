<Window x:Class="Focus.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专注模式"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Foreground="{StaticResource TextBrush}">
    <!-- 外边距给阴影留空间 -->
    <Border Margin="10,4,10,12"
            CornerRadius="10"
            Background="{StaticResource SurfaceBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Direction="270" Opacity="0.25" />
        </Border.Effect>
        <Grid>
            <!-- 设定画面 -->
            <StackPanel x:Name="SetupPanel" Width="340" Margin="16,8,8,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="✕"
                            ToolTip="关闭（收到托盘）" Click="CloseButton_Click" />
                    <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Content="⚙"
                            ToolTip="设置" Click="SettingsButton_Click" />
                    <TextBlock Text="专注模式" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>

                <Grid Margin="0,12,8,0">
                    <TextBox x:Name="TaskBox" Padding="6,5" MaxLength="100" TextChanged="TaskBox_TextChanged" />
                    <TextBlock x:Name="TaskPlaceholder" Text="这次要做什么？（可选）" Margin="9,0,0,0"
                               VerticalAlignment="Center" IsHitTestVisible="False"
                               Foreground="{StaticResource SubtleTextBrush}" />
                </Grid>

                <DockPanel Margin="0,10,8,0">
                    <Button DockPanel.Dock="Right" Style="{StaticResource PrimaryButton}" Content="开始"
                            Width="96" IsDefault="True" Click="StartButton_Click" />
                    <ComboBox x:Name="DurationBox" IsEditable="True" Width="80" Padding="6,4"
                              VerticalContentAlignment="Center" ToolTip="1～60 分钟" />
                    <TextBlock Text="分钟" Margin="8,0,0,0" VerticalAlignment="Center" />
                </DockPanel>

                <TextBlock x:Name="SetupError" Margin="0,8,8,0" Visibility="Collapsed"
                           Foreground="{StaticResource DangerBrush}" />
            </StackPanel>

            <!-- 倒计时画面 -->
            <StackPanel x:Name="FocusPanel" Width="380" Margin="20,14,20,18" Visibility="Collapsed">
                <TextBlock x:Name="FocusTaskText" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis"
                           FontSize="14" Foreground="{StaticResource SubtleTextBrush}" />
                <TextBlock x:Name="TimeText" HorizontalAlignment="Center" Text="30:00"
                           FontFamily="Segoe UI" FontSize="60" FontWeight="Light"
                           Typography.NumeralAlignment="Tabular" />
                <TextBlock x:Name="StatusText" HorizontalAlignment="Center" Text="专注中"
                           Foreground="{StaticResource SubtleTextBrush}" />
                <ProgressBar x:Name="Progress" Height="4" Margin="0,12,0,16" Maximum="1"
                             BorderThickness="0" Background="#FFE9ECEF" Foreground="{StaticResource AccentBrush}" />
                <StackPanel x:Name="FocusButtons" Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button x:Name="PauseButton" Style="{StaticResource PrimaryButton}" Content="暂停"
                            Width="100" Click="PauseButton_Click" />
                    <Button Style="{StaticResource BaseButton}" Content="放弃" Width="100" Margin="12,0,0,0"
                            Click="AbandonButton_Click" />
                </StackPanel>
            </StackPanel>

            <!-- 小计时条 -->
            <StackPanel x:Name="CompactPanel" Orientation="Horizontal" Margin="16,5,16,6" Visibility="Collapsed"
                        ToolTip="鼠标移上来展开">
                <TextBlock x:Name="CompactTime" Text="30:00" FontFamily="Segoe UI" FontSize="18"
                           Typography.NumeralAlignment="Tabular" VerticalAlignment="Center" />
                <TextBlock x:Name="CompactTask" MaxWidth="180" Margin="10,0,0,0" VerticalAlignment="Center"
                           TextTrimming="CharacterEllipsis" Foreground="{StaticResource SubtleTextBrush}" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
