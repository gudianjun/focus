<Window x:Class="Focus.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="专注模式 - 设置"
        SizeToContent="WidthAndHeight"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI"
        FontSize="13"
        Background="{StaticResource SurfaceBrush}"
        Foreground="{StaticResource TextBrush}">
    <StackPanel Width="380" Margin="20,16,20,16">
        <CheckBox x:Name="AutoStartBox" Content="开机自动启动（启动后只显示托盘图标）" />

        <TextBlock Text="全局快捷键（开始 / 暂停）" Margin="0,16,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Content="清除" Margin="8,0,0,0"
                    Click="ClearHotKey_Click" />
            <TextBox x:Name="HotKeyBox" Padding="6,4" IsReadOnly="True" IsReadOnlyCaretVisible="False"
                     ToolTip="点击后按下新的组合键" PreviewKeyDown="HotKeyBox_PreviewKeyDown" />
        </DockPanel>
        <TextBlock Text="点击输入框后按下组合键，需要包含 Ctrl / Alt / Shift / Win 中的至少一个。"
                   TextWrapping="Wrap" FontSize="12" Margin="0,4,0,0"
                   Foreground="{StaticResource SubtleTextBrush}" />

        <TextBlock Text="结束提示音" Margin="0,16,0,4" />
        <DockPanel>
            <Button DockPanel.Dock="Right" Style="{StaticResource BaseButton}" Content="试听" Margin="8,0,0,0"
                    Click="PreviewSound_Click" />
            <ComboBox x:Name="SoundBox" Padding="6,4" />
        </DockPanel>

        <DockPanel Margin="0,16,0,4">
            <TextBlock x:Name="OpacityText" DockPanel.Dock="Right" Width="40" TextAlignment="Right" />
            <TextBlock Text="专注时窗口透明度（鼠标移上去时不透明）" />
        </DockPanel>
        <Slider x:Name="OpacitySlider" Minimum="0.3" Maximum="1" SmallChange="0.05" LargeChange="0.1"
                TickFrequency="0.05" IsSnapToTickEnabled="True" ValueChanged="OpacitySlider_ValueChanged" />

        <CheckBox x:Name="AutoCompactBox" Content="专注开始几秒后自动缩成小计时条" Margin="0,16,0,0" />

        <DockPanel Margin="0,24,0,0">
            <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Content="打开数据文件夹"
                    FontSize="12" Click="OpenDataFolder_Click" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Style="{StaticResource PrimaryButton}" Content="确定" Width="84" IsDefault="True"
                        Click="OkButton_Click" />
                <Button Style="{StaticResource BaseButton}" Content="取消" Width="84" Margin="8,0,0,0"
                        IsCancel="True" />
            </StackPanel>
        </DockPanel>
    </StackPanel>
</Window>
